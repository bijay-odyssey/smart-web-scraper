GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: real search APIs, tried before free scraping backends when
# set. Neither is required -- without them, search falls back to
# DuckDuckGo/Bing scraping automatically.
TAVILY_API_KEY=
BRAVE_API_KEY=

# Only used by examples/agent_example.py (the tool-calling demo). A
# different model than GROQ_MODEL because openai/gpt-oss models can
# hallucinate phantom tool calls in a multi-turn tool loop -- see the
# comment in that file for details.
AGENT_MODEL=qwen/qwen3.8-27b
